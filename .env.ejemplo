# Ejemplo de .env.local. NO pongas claves aquí: este archivo sí se sube a GitHub.
# Las claves se escriben en la Terminal con:  npm run claves
# Los ajustes (no secretos) con:              npm run ajustes -- NOMBRE="valor"

# Tu compañía
NEXT_PUBLIC_COMPANY_NAME="Techos Ejemplo LLC"
NEXT_PUBLIC_APP_NAME="Techos Ejemplo CRM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TIME_ZONE="America/Chicago"
SIGNUP_ALLOWED_EMAILS="dueno@techosejemplo.com"

# Supabase (npm run claves -- supabase)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_DB_URL=""

# Correos con Resend (npm run claves -- correo)
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="Techos Ejemplo <avisos@techosejemplo.com>"
NOTIFY_EMAIL=""

# Stripe, opcional (npm run claves -- stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Google Calendar y Gmail (npm run claves -- google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Se crea solo
CRON_SECRET=""
